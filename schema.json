{
  "tables": {
    "users": {
      "engine": "InnoDB",
      "charset": "utf8mb4",
      "collation": "utf8mb4_unicode_ci",
      "columns": {
        "id": {
          "type": "BIGINT UNSIGNED",
          "nullable": false,
          "auto_increment": true
        },
        "username": {
          "type": "VARCHAR(64)",
          "nullable": false
        },
        "email": {
          "type": "VARCHAR(254)",
          "nullable": false
        },
        "password": {
          "type": "VARCHAR(255)",
          "nullable": false
        },
        "created_at": {
          "type": "DATETIME",
          "nullable": false,
          "default": "CURRENT_TIMESTAMP",
          "default_raw": true
        },
        "is_confirmed": {
          "type": "BOOL",
          "nullable": false,
          "default": 0
        },
        "confirmed_at": {
          "type": "DATETIME",
          "nullable": false,
          "default": "CURRENT_TIMESTAMP",
          "default_raw": true
        },
        "last_online": {
          "type": "DATETIME",
          "nullable": false,
          "default": "CURRENT_TIMESTAMP",
          "default_raw": true
        }
      },
      "primary_key": [
        "id"
      ],
      "indexes": [
        {
          "name": "uq_users_username",
          "columns": [
            "username"
          ],
          "unique": true
        },
        {
          "name": "uq_users_email",
          "columns": [
            "email"
          ],
          "unique": true
        }
      ]
    }
  }
}